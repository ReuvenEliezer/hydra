<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.reuven</groupId>
        <artifactId>hydra</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>browser-edge-starter</artifactId>
    <name>browser-edge-starter</name>
    <description>
        Single source of the browser origin policy (CORS) and the controlled tenant-domain set it
        validates against. Self-contained Spring Boot auto-configuration - any browser-facing
        service adds this one dependency and a hydra.cors.* / hydra.tenant.base-domains YAML
        block. Deliberately NOT part of infra-shared: infra-shared stays a dependency-free POJO
        jar, and CorsConfiguration/CorsConfigurationSource are Spring Web types, so this module
        owns every framework dependency the browser-edge domain needs.
    </description>
    <packaging>jar</packaging>

    <properties>
        <guava.version>33.4.0-jre</guava.version>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Declared explicitly rather than relied upon transitively: an undeclared transitive
             that disappears on a dependency bump would silently break the public-suffix check
             this module uses it for (research R3). -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>${guava.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
