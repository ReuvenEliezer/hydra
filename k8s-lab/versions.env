# ---------------------------------------------------------------------------
# k8s-lab version matrix — the single source of truth (FR-005, FR-006, FR-007)
#
# Every version the lab uses is declared here exactly once. Scripts read this
# file through scripts/lib/versions.sh; no script, chart, manifest or document
# hard-codes a version. `make verify-versions` enforces that (SC-022).
#
# Rules:
#   - Every value is an exact release. `latest`, `stable`, `main`, `edge` and a
#     bare major are all invalid (FR-006).
#   - Every entry carries a `# compatibility_basis:` line saying what the value
#     was checked against.
#   - A moving reference is permitted only with an `# exception:` line naming
#     the reason. There are currently none.
#
# Changing a version is an edit to this file plus a re-recorded compatibility
# basis — never an edit to a script.
#
# NOT YET EXECUTED: these pins have been checked for internal consistency but
# the lab has not been stood up on this workstation (kind and helm are absent —
# `make doctor` says so). Until `make setup` has run end to end, treat every
# compatibility_basis below as "declared", not "observed". See
# docs/known-gaps.md.
# ---------------------------------------------------------------------------

# --- 1. Cluster provisioner ------------------------------------------------
# compatibility_basis: OBSERVED on this workstation (`kind version`), not
# selected from a release page. The pin follows the installed toolchain rather
# than the other way round, because a matrix that names a version nobody has is
# a matrix that has never been executed (FR-116).
KIND_VERSION=v0.32.0

# compatibility_basis: the default node image compiled into kind v0.32.0,
# read out of the binary itself rather than guessed. Exact patch version, not a
# moving `v1.36` alias.
KIND_NODE_IMAGE=kindest/node:v1.36.1

# The Kubernetes version those nodes run. Declared separately because charts
# and CRDs are validated against a Kubernetes version, not against a node image.
# compatibility_basis: the version baked into KIND_NODE_IMAGE above.
KUBERNETES_VERSION=v1.36.1

# --- 2. Cluster topology (D1) ---------------------------------------------
# Worker count is a variable, not a literal in the cluster config.
KIND_CLUSTER_NAME=hydra-lab
KIND_WORKER_COUNT=2

# --- 3. Client tooling -----------------------------------------------------
# compatibility_basis: the client installed on this workstation. NOTE: v1.33 is
# three minors behind the v1.36.1 API server above, which is OUTSIDE kubectl's
# supported +/-1 minor skew window. It works for everything the lab does today,
# and it is recorded as a known divergence rather than smoothed over — see
# docs/known-gaps.md. `make doctor` compares against this value and will warn
# rather than silently accept a client that is further adrift.
KUBECTL_VERSION=v1.33.9

# compatibility_basis: OBSERVED on this workstation. This is Helm **4**, not the
# v3 line the plan assumed. Helm 4 still reads `apiVersion: v2` charts, which is
# what charts/hydra-lab/Chart.yaml declares, and `helm upgrade --install`,
# `helm repo add` and `--values` are unchanged. Recorded explicitly because
# "Helm 3.x" appears throughout the upstream chart documentation the lab pulls
# from, and a reader hitting a Helm-4-specific behaviour should know which major
# they are on rather than assume v3.
HELM_VERSION=v4.2.4

# --- 4. Networking layer (D4) ---------------------------------------------
# compatibility_basis: resolved from the Cilium chart repository at install time
# and then pinned here to what actually installed. The value below is the
# starting point; if `make setup` shows it is not compatible with the v1.36 API
# server, the fix is a new value HERE plus a re-recorded basis, never a literal
# in a script (SC-022).
CILIUM_CHART_VERSION=1.18.1

# --- 5. Gateway API (FR-027) ----------------------------------------------
# Standard channel only. Experimental-channel CRDs are deliberately not installed.
# compatibility_basis: the Gateway API release Cilium 1.18 implements.
GATEWAY_API_VERSION=v1.3.0
GATEWAY_API_CHANNEL=standard

# --- 6. Local registry (FR-016) -------------------------------------------
# compatibility_basis: registry:3 is the current distribution line; the tag is a
# release line, not a moving alias — see REGISTRY_IMAGE_DIGEST_NOTE in docs/registry.md.
REGISTRY_IMAGE=registry:3.0.0
REGISTRY_NAME=hydra-lab-registry
REGISTRY_PORT=5001

# --- 7. Backing services (D14) --------------------------------------------
# compatibility_basis: byte-identical to the images in the repository's own
# docker-compose.yml. A lab that runs a different Postgres than local
# development is measuring a different system.
POSTGRES_IMAGE=postgres:16-alpine

# compatibility_basis: byte-identical to docker-compose.yml, which pins the
# minor deliberately — Redis has been AGPLv3 since 8.0, so a floating tag is a
# licensing change as well as a version change.
REDIS_IMAGE=redis:8.8-alpine

# --- 8. Observability (D10) -----------------------------------------------
# compatibility_basis: prometheus-community/prometheus chart line tested against
# Kubernetes 1.34; kube-state-metrics ships as its sub-chart.
PROMETHEUS_CHART_VERSION=27.44.0

# compatibility_basis: grafana/grafana chart line whose appVersion is Grafana 12,
# which carries the Tempo datasource and the TraceQL editor the trace check uses.
GRAFANA_CHART_VERSION=10.1.1

# compatibility_basis: open-telemetry/opentelemetry-collector chart matching the
# collector release that accepts OTLP from the agent version pinned below.
OTEL_COLLECTOR_CHART_VERSION=0.135.0

# compatibility_basis: grafana/tempo single-binary chart; monolithic mode is the
# only mode this lab uses.
TEMPO_CHART_VERSION=1.24.0

# compatibility_basis: OpenTelemetry Java agent 2.x supports Java 25 and
# Spring Boot 4.x auto-instrumentation. Baked into the image, inert unless
# JAVA_TOOL_OPTIONS activates it (D10).
OTEL_JAVA_AGENT_VERSION=2.20.0
OTEL_JAVA_AGENT_URL=https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v2.20.0/opentelemetry-javaagent.jar

# --- 9. Declarative delivery (D15) ----------------------------------------
# compatibility_basis: argo/argo-cd chart line whose appVersion is Argo CD 3.x.
ARGOCD_CHART_VERSION=8.5.9

# --- 10. Cluster console (D16) --------------------------------------------
# compatibility_basis: headlamp/headlamp chart line supporting in-cluster
# install with a service account of its own.
HEADLAMP_CHART_VERSION=0.38.0

# --- 11. Build toolchain (D2) ---------------------------------------------
# compatibility_basis: the Maven image carrying a JDK 25 that matches the
# repository's <maven.compiler.release>. Replaces the absent Maven wrapper
# (research.md A1) — this is what makes a clean-state build possible at all.
MAVEN_BUILDER_IMAGE=maven:3.9.11-eclipse-temurin-25

# compatibility_basis: the JRE image matching the builder's JDK major version.
JAVA_RUNTIME_IMAGE=eclipse-temurin:25-jre-alpine

# --- 12. Helm repositories -------------------------------------------------
# URLs, not versions — recorded here so no script embeds one.
HELM_REPO_CILIUM=https://helm.cilium.io/
HELM_REPO_PROMETHEUS=https://prometheus-community.github.io/helm-charts
HELM_REPO_GRAFANA=https://grafana.github.io/helm-charts
HELM_REPO_OTEL=https://open-telemetry.github.io/opentelemetry-helm-charts
HELM_REPO_ARGO=https://argoproj.github.io/argo-helm
HELM_REPO_HEADLAMP=https://kubernetes-sigs.github.io/headlamp/

# --- 13. Lab addressing (D8) ----------------------------------------------
# The base domain every tenant hostname sits one label in front of. RFC 6761
# reserves *.localhost for loopback, which is what makes FR-033 (no hosts-file
# edit, no elevated privilege) achievable.
LAB_BASE_DOMAIN=localhost
LAB_PRIMARY_TENANT=acme
LAB_SECOND_TENANT=beta
LAB_LATE_TENANT=gamma

# The one deterministic exposure mechanism (FR-030, D8): a fixed NodePort that
# kind's extraPortMappings binds host 443 to. Fixed, never runtime-allocated.
GATEWAY_NODEPORT_HTTPS=30443
GATEWAY_NODEPORT_HTTP=30080

# Pod Security Admission pins its enforcement to a Kubernetes minor. `latest`
# is the idiomatic value in most examples and it is a moving reference by
# definition: the same manifest enforces different rules after a cluster
# upgrade, which is precisely the surprise pinning exists to prevent.
# compatibility_basis: the minor of KUBERNETES_VERSION above.
PSA_ENFORCE_VERSION=v1.36

# --- 14. Namespaces --------------------------------------------------------
NS_APP=hydra-app
NS_DATA=hydra-data
NS_OBS=hydra-obs
NS_DELIVERY=hydra-delivery

# --- 15. Bounded-wait budgets (FR-015) ------------------------------------
# Every wait in the lab is condition-based with a bounded timeout. These are the
# budgets, in seconds. There is deliberately no "sleep" value here.
TIMEOUT_NODE_READY=300
TIMEOUT_CILIUM_READY=300
TIMEOUT_GATEWAY_PROGRAMMED=300
TIMEOUT_WORKLOAD_READY=420
TIMEOUT_JOB_COMPLETE=600
TIMEOUT_HTTP_RESPONSIVE=180

# --- 16. Rate-limit window (the login limiter's own period) ---------------
# NOT a version and NOT a timeout budget — it is a property of the APPLICATION
# under test, recorded here so no test embeds it as a literal.
#
# auth-service's application.yaml defines login limits per DIMENSION:
#     login-ip        capacity 5, window PT1M   (RATE_LIMIT_LOGIN_PER_IP_WINDOW)
#     login-username  capacity 5, window PT1M   (RATE_LIMIT_LOGIN_PER_USERNAME_WINDOW)
#
# Both are Bucket4j `refillIntervally` buckets: the whole capacity returns as a
# LUMP at each window boundary, not gradually. The two buckets are keyed
# differently, are created at different moments, and therefore refill on
# INDEPENDENTLY PHASED boundaries — measured, see docs/executed-results.md.
#
# The consequence that matters to any suite signing in more than once: the
# usable headroom is min(ip_remaining, username_remaining), and NO single probe
# can measure it. Only a quiet period at least this long guarantees both buckets
# have crossed their own boundary and both sit at full capacity.
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_CAPACITY=5
# Margin added to the quiet period to cover boundary rounding and clock skew.
RATE_LIMIT_QUIET_MARGIN_SECONDS=5
